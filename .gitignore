tools/tts/ref.wav
tools/tts/ref24.wav
tools/tts/ref.txt
assets/voices/

# ---------- 模型：仅入库运行时必需的 int8 推理模型（编译后即完整可用） ----------
# 开发用 fp32 模型与下载用 tar 包不入库；模型来源见 THIRD-PARTY-NOTICES.txt 第三节
models/*
!models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20/
models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20/test_wavs/
!models/sherpa-onnx-zipvoice-distill-int8-zh-en-emilia/
models/sherpa-onnx-zipvoice-distill-int8-zh-en-emilia/test_wavs/
!models/vocos_24khz.onnx
!models/lexicon-en-us.txt

# ---------- 开发者工具与大体积中间产物 ----------
tools/tts/build/
tools/tts/dist/
tools/tts/__pycache__/
